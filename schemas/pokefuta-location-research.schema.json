{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.pokefuta.com/schemas/pokefuta-location-research.schema.json",
  "title": "ポケふた設置場所調査レコード",
  "description": "調査結果NDJSONの1行を検証するJSON Schema。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "candidate",
    "evidence",
    "field_confidence",
    "confidence",
    "decision",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "spatial_check": {
      "$ref": "#/$defs/spatialCheck"
    },
    "field_confidence": {
      "$ref": "#/$defs/fieldConfidence"
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "decision": {
      "enum": [
        "accept",
        "review",
        "unresolved",
        "conflict",
        "relocated"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "accept"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "confidence": {
            "const": 3
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "unresolved",
              "conflict",
              "relocated"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "building": {
          "type": "string",
          "minLength": 1
        },
        "place_detail": {
          "type": "string",
          "minLength": 1
        },
        "landmark": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "$ref": "manhole-tags.schema.json#/$defs/tagArray"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "source_type",
        "summary",
        "published_at",
        "checked_at"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source_type": {
          "enum": [
            "municipality_official",
            "prefecture_official",
            "facility_official",
            "pokemon_official",
            "tourism_official",
            "open_data",
            "map",
            "search_result",
            "user_content"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "published_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "spatialCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "official_coordinates",
            "osm_polygon_contains",
            "osm_nearest",
            "address_match",
            "manual_map_check",
            "not_checked"
          ]
        },
        "distance_m": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "fieldConfidence": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "building": {
          "$ref": "#/$defs/confidence"
        },
        "place_detail": {
          "$ref": "#/$defs/confidence"
        },
        "landmark": {
          "$ref": "#/$defs/confidence"
        },
        "tags": {
          "type": "object",
          "propertyNames": {
            "$ref": "manhole-tags.schema.json#/$defs/tag"
          },
          "additionalProperties": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    }
  }
}
